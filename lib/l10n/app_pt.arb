{
  "@@locale": "pt",

  "appTitle": "EcoSafra",
  "@appTitle": {
    "description": "Nome do app, usado no título da janela e na splash"
  },

  "splashTagline": "Adube na hora certa. Proteja o rio.",
  "@splashTagline": {
    "description": "Frase de efeito na tela de abertura"
  },

  "splashStartButton": "Começar",
  "@splashStartButton": {
    "description": "Botão que encerra a splash e decide login vs. painel"
  },

  "signInWelcomeTitle": "Bem-vindo ao EcoSafra",
  "@signInWelcomeTitle": {
    "description": "Título da tela de login"
  },

  "signInWelcomeSubtitle": "Entre para acompanhar a previsão de chuva da sua área e saber a melhor janela para adubar.",
  "@signInWelcomeSubtitle": {
    "description": "Subtítulo explicando o propósito do login"
  },

  "signInGoogleButton": "Entrar com Google",
  "@signInGoogleButton": {
    "description": "Rótulo do botão de login quando ocioso"
  },

  "signInGoogleButtonLoading": "Entrando...",
  "@signInGoogleButtonLoading": {
    "description": "Rótulo do botão de login enquanto aguarda o Google"
  },

  "signInLocationDisclaimer": "Usamos sua localização apenas para buscar a previsão do tempo do seu talhão.",
  "@signInLocationDisclaimer": {
    "description": "Aviso de privacidade abaixo do botão de login"
  },

  "dashboardTitle": "Painel",
  "@dashboardTitle": {
    "description": "Título da AppBar do painel principal"
  },

  "dashboardSignOutTooltip": "Sair",
  "@dashboardSignOutTooltip": {
    "description": "Tooltip do botão de logout no painel"
  },

  "dashboardDefaultUserName": "Produtor",
  "@dashboardDefaultUserName": {
    "description": "Nome exibido quando a conta Google não tem displayName"
  },

  "dashboardOfflineBanner": "Sem internet. Mostrando a última previsão salva, de {time}.",
  "@dashboardOfflineBanner": {
    "description": "Aviso quando a previsão exibida veio do cache local",
    "placeholders": {
      "time": {
        "type": "String",
        "example": "14:32"
      }
    }
  },

  "dashboardErrorTitle": "Não foi possível carregar a previsão.",
  "@dashboardErrorTitle": {
    "description": "Título exibido quando busca de localização ou clima falha"
  },

  "dashboardRetryButton": "Tentar de novo",
  "@dashboardRetryButton": {
    "description": "Botão para tentar buscar a previsão novamente"
  },

  "dashboardNowCardTitle": "Agora",
  "@dashboardNowCardTitle": {
    "description": "Título do card com as condições atuais"
  },

  "dashboardHumidityLabel": "Umidade",
  "@dashboardHumidityLabel": {
    "description": "Rótulo do valor de umidade relativa"
  },

  "dashboardWindLabel": "Vento",
  "@dashboardWindLabel": {
    "description": "Rótulo do valor de velocidade do vento"
  },

  "dashboardNext48hRainLabel": "Chuva prevista (48h)",
  "@dashboardNext48hRainLabel": {
    "description": "Rótulo do total de chuva acumulada nas próximas 48 horas"
  },

  "dashboardDailyForecastTitle": "Próximos dias",
  "@dashboardDailyForecastTitle": {
    "description": "Título da lista de previsão diária"
  },

  "decisionCardSafeHeadline": "Pode aplicar",
  "@decisionCardSafeHeadline": {
    "description": "Título do card de decisão quando é seguro adubar"
  },

  "decisionCardCautionHeadline": "Aplique com cautela",
  "@decisionCardCautionHeadline": {
    "description": "Título do card de decisão quando há chuva moderada prevista"
  },

  "decisionCardDangerHeadline": "Não aplique fertilizante",
  "@decisionCardDangerHeadline": {
    "description": "Título do card de decisão quando há chuva forte prevista"
  },

  "decisionCardRainNext24h": "{mm} mm previstos nas próximas 24h",
  "@decisionCardRainNext24h": {
    "description": "Subtítulo do card de decisão com o volume de chuva esperado",
    "placeholders": {
      "mm": {
        "type": "String",
        "example": "12.4"
      }
    }
  },

  "decisionCardEstimatedLoss": "Risco de perda de insumo estimado em {percent}%",
  "@decisionCardEstimatedLoss": {
    "description": "Aviso de risco financeiro exibido quando o nível é perigo",
    "placeholders": {
      "percent": {
        "type": "int"
      }
    }
  }
}
